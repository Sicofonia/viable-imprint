ZAI_API_KEY=your-zai-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
GOOGLE_AISTUDIO_API_KEY=your-google-aistudio-api-key-here
DEEPL_API_KEY=your-deepl-api-key-here
# eTranslation (ADR 022): the application name and password issued at registration,
# plus the shared secret that must equal RECEIVER_SECRET on the Vercel receiver.
ETRANSLATION_APP_NAME=your-etranslation-application-name
ETRANSLATION_PASSWORD=your-etranslation-password
ETRANSLATION_RECEIVER_SECRET=your-receiver-secret
