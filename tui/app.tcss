/* Stylesheet for the terminal UI (ADR 023). */

HomeScreen #welcome {
    padding: 1 2;
    text-style: bold;
}

HomeScreen #menu {
    margin: 0 2;
    height: auto;
    max-height: 20;
}

PlaceholderScreen #placeholder {
    padding: 1 2;
}

RunScreen, HelpScreen {
    align: center middle;
}

#run-dialog {
    width: 90%;
    height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#run-title {
    text-style: bold;
    margin-bottom: 1;
}

#run-confirm {
    height: 1fr;
    padding: 1 0;
}

#run-log {
    height: 1fr;
    border: round $primary-darken-2;
}

#run-summary {
    height: auto;
    padding: 1 0;
    text-style: bold;
}

#run-buttons {
    height: auto;
    align-horizontal: right;
}

#run-buttons Button {
    margin-left: 1;
}

#help-dialog {
    width: 80;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    margin-bottom: 1;
}

#help-notes {
    margin-top: 1;
}

ExplorerScreen #explorer {
    height: 1fr;
}

ExplorerScreen #explorer-left {
    width: 45%;
    padding: 0 1;
}

ExplorerScreen #commands {
    height: 1fr;
}

ExplorerScreen #explorer-right {
    width: 55%;
    padding: 0 2;
}

ExplorerScreen #detail-title {
    text-style: bold;
    margin-top: 1;
}

ExplorerScreen #detail-help {
    margin-bottom: 1;
}

ExplorerScreen #detail-warning {
    color: $warning;
    margin-bottom: 1;
}

ExplorerScreen #run {
    margin-top: 1;
}

FilePickerScreen {
    align: center middle;
}

#picker-dialog {
    width: 80%;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#picker-title {
    text-style: bold;
}

#picker-tree {
    height: 1fr;
}

#picker-buttons {
    height: auto;
    align-horizontal: right;
}

HomeScreen #books-empty {
    padding: 0 2;
    color: $text-muted;
}

HomeScreen #books {
    margin: 0 2 1 2;
    height: auto;
    max-height: 16;
}

NewBookScreen {
    align: center middle;
}

#newbook-dialog {
    width: 80%;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#newbook-title {
    text-style: bold;
    margin-bottom: 1;
}

#nb-source-row {
    height: auto;
}

#nb-source-row Input {
    width: 1fr;
}

#nb-error {
    color: $error;
    height: auto;
}

#nb-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

#nb-buttons Button {
    margin-left: 1;
}

BookScreen #book-title {
    padding: 0 2;
    text-style: bold;
}

BookScreen #book-main {
    height: 1fr;
}

BookScreen #tasks {
    width: 65%;
}

BookScreen #task-panel {
    width: 35%;
    padding: 0 2;
}

BookScreen #task-actions {
    height: auto;
    margin-top: 1;
}

BookScreen #task-hint {
    padding: 0;
}

BookScreen #pipeline-title {
    text-style: bold;
    margin-top: 2;
}

BookScreen #pipeline-hint {
    padding: 0;
}

BookScreen #book-actions-title {
    text-style: bold;
    margin-top: 2;
}

BookScreen #isbn-row {
    height: auto;
}

BookScreen #isbn-row Input {
    width: 1fr;
}

BookScreen #isbn-error {
    color: $error;
    height: auto;
}

PrintPrepScreen #pp-note {
    padding: 0 2;
    color: $text-muted;
    height: auto;
}

PrintPrepScreen .size {
    height: auto;
    padding: 0 1;
    color: $success;
}

PrintPrepScreen .pp-actions {
    height: auto;
    margin-top: 1;
}

PrintPrepScreen .pp-actions Button {
    margin-right: 1;
}
